# Copy to .env.local for local development. Values below match docker-compose.yml.
# In production (Cloud Run) set these as environment variables / Secret Manager secrets.

# Public origin of this app — used for CORS rules on the bucket and absolute links (QR codes).
APP_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=tohsevent

# Object storage (Cloudflare R2 in production; RustFS locally)
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=devaccesskey
R2_SECRET_ACCESS_KEY=devsecretkey
R2_BUCKET=tohsevent-dev
# Base URL that serves bucket objects publicly (R2 custom domain in production, e.g. https://media.tohsevent.com)
R2_PUBLIC_BASE_URL=http://localhost:9000/tohsevent-dev

# Secret for signing guest session cookies (at least 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef

# Secret for host accounts (Better Auth: session tokens, cookie signing). At least 32 chars, different from SESSION_SECRET.
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef

# Optional: secret for scheduled jobs (POST /api/internal/cleanup with "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=dev-only-cron-secret-change-me-0123456789abcdef

# Optional: Stripe (paid plan upgrades). Use test-mode keys outside production.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
